{
  "cli": {
    "version": ">= 5.9.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_BILLING_CHANNEL": "direct"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "direct": {
      "extends": "production",
      "channel": "direct",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BILLING_CHANNEL": "direct"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
