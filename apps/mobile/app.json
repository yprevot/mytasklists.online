{
  "expo": {
    "name": "MyTaskLists",
    "slug": "mytasklists",
    "version": "2.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "scheme": "mytasklists",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.mytasklists.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserTrackingUsageDescription": "Solo usamos identificadores para entregar tus notificaciones."
      },
      "associatedDomains": [
        "webcredentials:mytasklists.online"
      ]
    },
    "android": {
      "package": "online.mytasklists.app",
      "adaptiveIcon": {
        "backgroundColor": "#1d5b45"
      },
      "permissions": [
        "NOTIFICATIONS",
        "POST_NOTIFICATIONS",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1d5b45",
          "resizeMode": "contain",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1d5b45"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:8080/api",
      "socketUrl": "http://localhost:8080",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "googleWebClientId": "",
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "icon": "./assets/icon.png"
  }
}
