# ─────────────────────────────────────────────────────────────
#  MyTaskLists · variables de entorno
#  Copia este archivo a `.env` y ajusta los valores.
#
#  Estos valores son para DESARROLLO. En producción el backend se niega a
#  arrancar si conservas los secretos de ejemplo (ver "Despliegue en producción"
#  en el README). Genera secretos con:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────

# ---------- Puertos publicados en el host (solo 127.0.0.1 salvo nginx) ----------
NGINX_HTTP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_UI_PORT=8025

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_DB=mytasklists
POSTGRES_USER=lista
POSTGRES_PASSWORD=lista_dev_password

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PASSWORD=lista_dev_redis

# ---------- Backend ----------
NODE_ENV=development
BACKEND_PORT=3000
API_PREFIX=api
# Claves para firmar los JWT (distintas entre sí y de 32+ caracteres en producción)
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_REFRESH_TTL=30d
# Clave para cifrar secretos en reposo (2FA). Obligatoria en producción.
APP_ENCRYPTION_KEY=
# Orígenes permitidos por CORS, separados por coma (nunca "*" en producción)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:19006
# URL pública desde la que se sirve todo el sistema (enlaces de correo y redirects OAuth)
PUBLIC_URL=http://localhost:8080
# Saltos de proxy de confianza para calcular la IP del cliente (nginx = 1)
TRUST_PROXY=1
# Documentación OpenAPI en /api/docs (por defecto: sí en desarrollo, no en producción)
SWAGGER_ENABLED=
# Ejecuta las migraciones automáticamente al arrancar
RUN_MIGRATIONS=true
# Carga usuarios/listas de demostración al arrancar. SOLO DESARROLLO: las pruebas
# e2e lo necesitan, pero crea cuentas con contraseñas públicas.
RUN_SEED=true

# ---------- Rate limiting ----------
# Vacío = valores por defecto (holgados en desarrollo, estrictos en producción)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=
RATE_LIMIT_AUTH=
RATE_LIMIT_SENSITIVE=
# Intentos fallidos de login por correo antes de bloquearlo 15 minutos
LOGIN_MAX_FAILURES=10

# ---------- Correo (verificación y recuperación de contraseña) ----------
# En desarrollo se usa Mailpit (bandeja en http://localhost:8025).
# En producción: SMTP de tu proveedor (Amazon SES, Resend, Postmark, SendGrid…).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MyTaskLists <no-responder@mytasklists.local>

# ---------- Google (web + app móvil) ----------
# Consola: https://console.cloud.google.com/apis/credentials (ver README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
# client_id de iOS y Android separados por coma (id_token de la app nativa)
GOOGLE_ALLOWED_AUDIENCES=

# ---------- Sign in with Apple ----------
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:8080/api/auth/apple/callback
# Bundle id de la app iOS (identityToken nativo), p. ej. online.mytasklists.app
APPLE_ALLOWED_AUDIENCES=

# ---------- Recurrencia ----------
# Cada cuánto revisa el scheduler los productos recurrentes (formato cron)
RECURRENCE_CRON=0 */5 * * * *
# Zona horaria usada para calcular vencimientos
TZ=America/Mexico_City

# ---------- Notificaciones push (Expo) ----------
EXPO_ACCESS_TOKEN=

# ---------- Compatibilidad de la app móvil (docs/COMPATIBILIDAD.md) ----------
# Las apps por debajo de esta versión reciben 426 y se les pide actualizar.
# Súbela solo después de publicar la versión que ya no usa lo que vas a retirar.
MOBILE_MIN_VERSION=1.0.0
MOBILE_STORE_URL_IOS=
MOBILE_STORE_URL_ANDROID=

# ---------- Frontend / Dashboard (build args de Vite) ----------
VITE_API_URL=/api
VITE_SOCKET_URL=/
VITE_GOOGLE_ENABLED=true
VITE_APPLE_ENABLED=true

# ---------- Landing ----------
LANDING_IOS_URL=https://apps.apple.com/app/id000000000
LANDING_ANDROID_URL=https://play.google.com/store/apps/details?id=online.mytasklists.app

# ---------- Pruebas e2e ----------
E2E_BASE_URL=http://localhost:8080
E2E_API_URL=http://localhost:8080/api
E2E_MAILPIT_URL=http://localhost:8025
