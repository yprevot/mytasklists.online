# ─────────────────────────────────────────────────────────────
#  ListaDeCompras · variables de entorno
#  Copia este archivo a `.env` y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# ---------- Puertos publicados en el host ----------
NGINX_HTTP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_DB=listadecompras
POSTGRES_USER=lista
POSTGRES_PASSWORD=lista_dev_password

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PASSWORD=

# ---------- Backend ----------
NODE_ENV=development
BACKEND_PORT=3000
API_PREFIX=api
# Clave para firmar los JWT de acceso (cambiar en produccion)
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_REFRESH_TTL=30d
# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:19006
# URL publica desde la que se sirve todo el sistema (usada en los redirects OAuth)
PUBLIC_URL=http://localhost:8080
# Ejecuta las migraciones automaticamente al arrancar
RUN_MIGRATIONS=true
# Carga usuarios/listas de demostracion al arrancar (util para las pruebas e2e)
RUN_SEED=true

# ---------- OAuth Google ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# ---------- Sign in with Apple ----------
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:8080/api/auth/apple/callback

# ---------- Recurrencia ----------
# Cada cuanto revisa el scheduler los productos recurrentes (formato cron)
RECURRENCE_CRON=0 */5 * * * *
# Zona horaria usada para calcular vencimientos
TZ=America/Mexico_City

# ---------- Notificaciones push (Expo) ----------
EXPO_ACCESS_TOKEN=

# ---------- Frontend / Dashboard (build args de Vite) ----------
VITE_API_URL=/api
VITE_SOCKET_URL=/
VITE_GOOGLE_ENABLED=true
VITE_APPLE_ENABLED=true

# ---------- Landing ----------
LANDING_IOS_URL=https://apps.apple.com/app/id000000000
LANDING_ANDROID_URL=https://play.google.com/store/apps/details?id=com.listadecompras.app

# ---------- Pruebas e2e ----------
E2E_BASE_URL=http://localhost:8080
E2E_API_URL=http://localhost:8080/api
